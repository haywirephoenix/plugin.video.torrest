        <!-- Player -->
        <category id="player" label="30255">
            <group id="1">
                <setting id="overlay" type="boolean" label="30004">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="show_bg_progress" type="boolean" label="30068">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <!-- The daemon's own buffering (download?buffer=true) uses it, but this add-on pre-buffers buffer_start / buffer_end itself (lib/prebuffer.py), so it's hidden -->
                <setting id="s:buffer_size" type="integer" label="30012">
                    <level>0</level>
                    <default>20971520</default>
                    <visible>false</visible>
                    <control type="edit" format="integer">
                        <heading>30012</heading>
                    </control>
                </setting>
                <setting id="buffer_start" type="integer" label="30094">
                    <level>0</level>
                    <default>15</default>
                    <constraints>
                        <minimum>5</minimum>
                        <step>5</step>
                        <maximum>200</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="buffer_end" type="integer" label="30095">
                    <level>0</level>
                    <default>5</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>1</step>
                        <maximum>20</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <!-- While a video plays (lib/stream_watch.py) -->
                <setting id="pause_when_behind" type="boolean" label="30278" help="30280">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="resume_ahead" type="integer" label="30279" help="30281" parent="pause_when_behind">
                    <level>0</level>
                    <default>30</default>
                    <constraints>
                        <minimum>10</minimum>
                        <step>5</step>
                        <maximum>300</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                    <dependencies>
                        <dependency type="visible" setting="pause_when_behind">true</dependency>
                    </dependencies>
                </setting>
            </group>
        </category>
        <!-- Deletion -->
