<?xml version="1.0" encoding="UTF-8"?>
<!-- Torrest's Add torrent/magnet dialog (lib/dialog.py). 1920 x 1080, in the torrent manager's
     colours; every control sets its own textures and colours, so a skin's control defaults don't
     restyle it. A skin can draw it its own way with a DialogInsert.xml of its own: ids 32500
     (close), 32501 / 32502 (URL / file radio buttons), 32504 (the box's label), 32505 (the box,
     whose label is the URL or path), 32506 (OK). -->
<window type="dialog">
    <defaultcontrol always="true">32501</defaultcontrol>
    <depth>DepthOSD</depth>
    <controls>
        <control type="image">
            <!-- Dims what's behind -->
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="B0000000">AddonWindow/white.png</texture>
        </control>
        <control type="group">
            <left>360</left>
            <top>300</top>
            <control type="image">
                <!-- Background -->
                <left>0</left>
                <top>0</top>
                <width>1200</width>
                <height>480</height>
                <texture colordiffuse="FF121418">AddonWindow/white.png</texture>
            </control>
            <control type="label" id="32503">
                <!-- Window title -->
                <left>40</left>
                <top>24</top>
                <width>1000</width>
                <height>60</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>center</aligny>
                <label>[B]$ADDON[plugin.video.torrest 30200][/B]</label>
            </control>
            <control type="button" id="32500">
                <!-- Close button -->
                <left>1128</left>
                <top>30</top>
                <width>48</width>
                <height>48</height>
                <texturefocus colordiffuse="FF4C8BF5">Button/close.png</texturefocus>
                <texturenofocus colordiffuse="FF8A929C">Button/close.png</texturenofocus>
                <label></label>
                <onup>32506</onup>
                <ondown>32501</ondown>
                <onleft>32505</onleft>
            </control>
            <control type="image">
                <left>40</left>
                <top>96</top>
                <width>1120</width>
                <height>2</height>
                <texture colordiffuse="FF3A3F47">AddonWindow/white.png</texture>
            </control>
            <control type="label" id="32504">
                <!-- Box label -->
                <left>40</left>
                <top>122</top>
                <width>700</width>
                <height>50</height>
                <font>font13</font>
                <textcolor>FF8A929C</textcolor>
                <aligny>center</aligny>
            </control>
            <control type="button" id="32505">
                <!-- The box: the URL or the file path -->
                <left>40</left>
                <top>180</top>
                <width>700</width>
                <height>80</height>
                <font>font13</font>
                <textcolor>FFB2D4F5</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="FF2D5C9E">AddonWindow/white.png</texturefocus>
                <texturenofocus colordiffuse="FF1E2228">AddonWindow/white.png</texturenofocus>
                <onright>32506</onright>
            </control>
            <control type="radiobutton" id="32501">
                <!-- Radio button: URL -->
                <left>780</left>
                <top>122</top>
                <width>380</width>
                <height>70</height>
                <font>font13</font>
                <label>$ADDON[plugin.video.torrest 30201]</label>
                <textcolor>FFC8CDD3</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="FF2D5C9E">AddonWindow/white.png</texturefocus>
                <texturenofocus colordiffuse="FF1E2228">AddonWindow/white.png</texturenofocus>
                <textureradioonfocus colordiffuse="FF4CAF50">AddonWindow/white.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FF4CAF50">AddonWindow/white.png</textureradioonnofocus>
                <textureradioofffocus colordiffuse="FF5A616B">AddonWindow/white.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FF3A3F47">AddonWindow/white.png</textureradiooffnofocus>
                <radioposx>332</radioposx>
                <radiowidth>24</radiowidth>
                <radioheight>24</radioheight>
                <onup>32500</onup>
                <ondown>32502</ondown>
                <onleft>32505</onleft>
            </control>
            <control type="radiobutton" id="32502">
                <!-- Radio button: file path -->
                <left>780</left>
                <top>202</top>
                <width>380</width>
                <height>70</height>
                <font>font13</font>
                <label>$ADDON[plugin.video.torrest 30202]</label>
                <textcolor>FFC8CDD3</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <texturefocus colordiffuse="FF2D5C9E">AddonWindow/white.png</texturefocus>
                <texturenofocus colordiffuse="FF1E2228">AddonWindow/white.png</texturenofocus>
                <textureradioonfocus colordiffuse="FF4CAF50">AddonWindow/white.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FF4CAF50">AddonWindow/white.png</textureradioonnofocus>
                <textureradioofffocus colordiffuse="FF5A616B">AddonWindow/white.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FF3A3F47">AddonWindow/white.png</textureradiooffnofocus>
                <radioposx>332</radioposx>
                <radiowidth>24</radiowidth>
                <radioheight>24</radioheight>
                <onup>32501</onup>
                <ondown>32506</ondown>
                <onleft>32505</onleft>
            </control>
            <control type="button" id="32506">
                <!-- OK button -->
                <left>780</left>
                <top>370</top>
                <width>380</width>
                <height>70</height>
                <font>font13</font>
                <label>$ADDON[plugin.video.torrest 30205]</label>
                <textcolor>FFC8CDD3</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <align>center</align>
                <aligny>center</aligny>
                <texturefocus colordiffuse="FF2D5C9E">AddonWindow/white.png</texturefocus>
                <texturenofocus colordiffuse="FF1E2228">AddonWindow/white.png</texturenofocus>
                <onup>32502</onup>
                <ondown>32500</ondown>
                <onleft>32505</onleft>
            </control>
        </control>
    </controls>
</window>
